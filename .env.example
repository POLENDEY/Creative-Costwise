# Dedicated database for this app only. Do not point this at depth_dot, sample_mflix, admin, or local.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/creative_costwise?retryWrites=true&w=majority"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Set on Vercel after creating a Blob store. Leave blank for local folder storage.
BLOB_READ_WRITE_TOKEN=""
# Protects the daily renewal-email schedule on Vercel.
CRON_SECRET=""
ADMIN_EMAIL="admin@local.test"
ADMIN_PASSWORD="change-this-before-deployment"
ADMIN_NOTIFICATION_EMAIL=""
INQUIRY_NOTIFY_TO=""
# Gmail: SMTP_SERVICE=gmail plus SMTP_USER and an app password (SMTP_PASSWORD or SMTP_PASS).
# Or set SMTP_HOST. Port 465 uses SMTP_SECURE=true; port 587 uses SMTP_SECURE=false.
SMTP_SERVICE=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_PASS=""
MAIL_FROM=""
EMAIL_FROM=""
