generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid()) @map("_id")
  name               String
  email              String        @unique
  passwordHash       String
  role               String        @default("crafter")
  plan               String?       @default("annual")
  expiresAt          DateTime?
  disabledAt         DateTime?
  mustChangePassword Boolean       @default(false)
  welcomedAt         DateTime?
  renewalReminderSentAt DateTime?
  renewalReminderFor    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  settings           ShopSettings?
  materials          Material[]
  printers           Printer[]
  costingTabs        CostingTab[]
  purchaseOrders     PurchaseOrder[]
  notifications      Notification[]
  planPayments       PlanPayment[]
  templateWishes     TemplateWish[]

  @@index([role, createdAt])
}

/// A renewal payment proof a crafter submitted for a plan, reviewed by the admin.
model PlanPayment {
  id          String    @id @default(cuid()) @map("_id")
  userId      String
  plan        String
  amountMinor Int
  method      String    @default("gcash")
  reference   String    @default("")
  note        String    @default("")
  proofPath   String
  status      String    @default("pending")
  adminNote   String    @default("")
  reviewedBy  String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
}

/// The shop's own payment details and QR code, shown on the plans page.
model PlanPaymentSettings {
  id           String   @id @map("_id")
  accountName  String   @default("")
  gcashNumber  String   @default("")
  mayaNumber   String   @default("")
  bankDetails  String   @default("")
  instructions String   @default("")
  qrPath       String?
  updatedAt    DateTime @updatedAt
}

model ShopSettings {
  userId                     String   @id @map("_id")
  currency                   String   @default("PHP")
  theme                      String   @default("pink")
  colorScheme                String   @default("light")
  logoPath                   String?
  businessName               String   @default("")
  businessAddress            String   @default("")
  businessPhone              String   @default("")
  businessEmail              String   @default("")
  paymentAccountName         String   @default("")
  bankDetails                String   @default("")
  gcashNumber                String   @default("")
  defaultLossPercent         Float  @default(3)
  defaultOperationalFeeMinor Int      @default(1000)
  defaultLaborPercent        Float  @default(100)
  markupRetailPercent        Float  @default(100)
  markupBulkPercent          Float  @default(50)
  markupPromoPercent         Float  @default(30)
  markupLoyalPercent         Float  @default(40)
  masterSheetUrl             String   @default("")
  checklistJson              String   @default("{}")
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Material {
  id                String   @id @default(cuid()) @map("_id")
  userId            String
  category          String   @default("Uncategorized")
  name              String
  piecesPerPack     Float
  pricePerPackMinor Int
  gsm               String   @default("")
  thickness         String   @default("")
  sizeNote          String   @default("")
  finish            String   @default("matte")
  finishOther       String   @default("")
  unitLabel         String   @default("piece")
  quantityOnHand    Float  @default(0)
  lowStockAlert     Float?
  supplierUrl       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  costingLines      CostingMaterialLine[]

  @@index([userId, category])
  @@index([userId, name])
  @@index([userId, updatedAt])
}

model Printer {
  id                 String   @id @default(cuid()) @map("_id")
  userId             String
  name               String
  inkType            String   @default("dye")
  colorInkPriceMinor Int      @default(0)
  colorPageYield     Float
  blackInkPriceMinor Int      @default(0)
  blackPageYield     Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  costingLines       CostingPrintLine[]

  @@index([userId, name])
}

model CostingTab {
  id                   String                @id @default(cuid()) @map("_id")
  userId               String
  name                 String
  overagePercent       Float               @default(0)
  lossPercent          Float               @default(3)
  operationalFeeMinor  Int                   @default(1000)
  laborPercent         Float               @default(100)
  packagingCostMinor   Int                   @default(0)
  markupRetailPercent  Float               @default(100)
  markupBulkPercent    Float               @default(50)
  markupPromoPercent   Float               @default(30)
  markupLoyalPercent   Float               @default(40)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialLines        CostingMaterialLine[]
  printLines           CostingPrintLine[]
  priceSets            PriceSet[]

  @@index([userId, updatedAt])
}

model CostingMaterialLine {
  id             String     @id @default(cuid()) @map("_id")
  costingTabId   String
  materialId     String
  unitsUsed      Float
  finishedPieces Float
  costingTab     CostingTab @relation(fields: [costingTabId], references: [id], onDelete: Cascade)
  material       Material   @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([costingTabId])
  @@index([materialId])
}

model CostingPrintLine {
  id             String     @id @default(cuid()) @map("_id")
  costingTabId   String
  printerId      String
  paperSize      String     @default("A4")
  quality        String     @default("standard")
  coverage       String     @default("normal_color")
  sheetCount     Float    @default(1)
  finishedPieces Float    @default(1)
  costingTab     CostingTab @relation(fields: [costingTabId], references: [id], onDelete: Cascade)
  printer        Printer    @relation(fields: [printerId], references: [id], onDelete: Restrict)

  @@index([costingTabId])
  @@index([printerId])
}

model PriceSet {
  id                  String     @id @default(cuid()) @map("_id")
  userId              String
  costingTabId        String
  name                String
  category            String     @default("Uncategorized")
  retailPriceMinor    Int
  bulkPriceMinor      Int
  productionCostMinor Int
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  costingTab          CostingTab @relation(fields: [costingTabId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, updatedAt])
  @@index([costingTabId])
}

model PurchaseOrder {
  id            String             @id @default(cuid()) @map("_id")
  userId        String
  status        String             @default("pending")
  currency      String             @default("PHP")
  note          String             @default("")
  response      String             @default("")
  respondedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  crafter       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines         PurchaseOrderLine[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model PurchaseOrderLine {
  id                    String               @id @default(cuid()) @map("_id")
  purchaseOrderId       String
  priceSetId            String?
  productName           String
  category              String
  pricingOption         String
  quantity              Int
  unitPriceMinor        Int
  unitProductionCostMinor Int
  lineTotalMinor        Int
  lineProductionCostMinor Int
  breakdownJson         String
  createdAt             DateTime             @default(now())
  purchaseOrder         PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem         AdminInventoryItem?

  @@index([purchaseOrderId])
  @@index([priceSetId])
}

model AdminInventoryItem {
  id                      String            @id @default(cuid()) @map("_id")
  purchaseOrderLineId     String            @unique
  crafterName             String
  crafterEmail            String
  productName             String
  category                String
  currency                String
  quantityReceived        Int
  quantityOnHand          Int
  unitPriceMinor          Int
  unitProductionCostMinor Int
  breakdownJson           String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  purchaseOrderLine       PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@index([category, productName])
  @@index([updatedAt])
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  title     String
  message   String
  href      String
  createdAt DateTime @default(now())
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model MaterialCategory {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  name      String
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, starred])
}

model Expense {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  occurredOn    DateTime @default(now())
  amountMinor   Int
  frequency     String   @default("once")
  category      String
  paymentMethod String
  description   String
  note          String   @default("")
  sourceKey     String   @unique
  createdAt     DateTime @default(now())

  @@index([userId, occurredOn])
  @@index([userId, category])
}

model InventoryMovement {
  id             String   @id @default(cuid()) @map("_id")
  userId         String
  materialId     String
  kind           String
  quantityBefore Float
  quantityAfter  Float
  note           String   @default("")
  expenseId      String?
  createdAt      DateTime @default(now())

  @@index([userId, materialId, createdAt])
  @@index([expenseId])
}

model PrinterSupply {
  id             String   @id @default(cuid()) @map("_id")
  userId         String
  name           String
  supplierUrl    String   @default("")
  lastPriceMinor Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model PrintTemplate {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  name      String
  url       String
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, name])
}

model Customer {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  name      String
  phone     String   @default("")
  email     String   @default("")
  address   String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name])
  @@index([userId, email])
}

model ShopOrder {
  id               String    @id @default(cuid()) @map("_id")
  userId           String
  customerId       String    @default("")
  customerName     String
  customerPhone    String    @default("")
  customerEmail    String    @default("")
  customerAddress  String    @default("")
  stage            String    @default("inquiry")
  paymentStatus    String    @default("unpaid")
  deliveryMethod   String    @default("pickup")
  discountMinor    Int       @default(0)
  shippingMinor    Int       @default(0)
  currency         String    @default("PHP")
  dueOn            DateTime?
  followUpOn       DateTime?
  note             String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, stage, updatedAt])
  @@index([userId, dueOn])
}

model ShopOrderLine {
  id                  String @id @default(cuid()) @map("_id")
  orderId             String
  userId              String
  kind                String @default("product")
  priceSetId          String @default("")
  sourceId            String @default("")
  label               String
  priceOption         String
  quantity            Float
  unitPriceMinor      Int
  productionCostMinor Int

  @@index([orderId])
  @@index([userId, orderId])
  @@index([sourceId])
}

model Bundle {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  name       String
  priceMinor Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, name])
  @@index([userId, updatedAt])
}

model BundleItem {
  id         String @id @default(cuid()) @map("_id")
  bundleId   String
  userId     String
  priceSetId String
  quantity   Float

  @@index([bundleId])
  @@index([userId, bundleId])
}

model Promotion {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  code          String   @default("")
  originalMinor Int
  kind          String
  discountMinor Int
  saleMinor     Int
  note          String   @default("")
  upcomingNote  String   @default("")
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model DigitalProduct {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  name       String
  priceMinor Int
  url        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, name])
  @@index([userId, updatedAt])
}

model ShopOrderStatus {
  id        String   @id @default(cuid()) @map("_id")
  orderId   String
  userId    String
  fromStage String   @default("")
  toStage   String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([userId, createdAt])
}

model Sale {
  id           String   @id @default(cuid()) @map("_id")
  userId       String
  orderId      String   @unique
  amountMinor  Int
  currency     String
  recognizedOn DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId, recognizedOn])
}

model BusinessDocument {
  id                 String   @id @default(cuid()) @map("_id")
  userId             String
  orderId            String   @default("")
  kind               String
  number             String
  customerName       String
  customerPhone      String   @default("")
  customerEmail      String   @default("")
  customerAddress    String   @default("")
  businessName       String   @default("")
  businessAddress    String   @default("")
  businessPhone      String   @default("")
  businessEmail      String   @default("")
  logoPath           String   @default("")
  paymentAccountName String   @default("")
  bankDetails        String   @default("")
  gcashNumber        String   @default("")
  currency           String   @default("PHP")
  discountMinor      Int      @default(0)
  shippingMinor      Int      @default(0)
  taxLabel           String   @default("")
  taxMinor           Int      @default(0)
  paymentStatus      String   @default("unpaid")
  deliveryMethod     String   @default("")
  courier            String   @default("")
  terms              String   @default("")
  note               String   @default("")
  issuedOn           DateTime @default(now())
  createdAt          DateTime @default(now())

  @@unique([userId, number])
  @@index([userId, createdAt])
  @@index([userId, orderId, kind])
}

model BusinessDocumentLine {
  id             String @id @default(cuid()) @map("_id")
  documentId     String
  userId         String
  label          String
  quantity       Float
  unitPriceMinor Int

  @@index([documentId])
  @@index([userId, documentId])
}

/// Provider links for the master-sheet template and the annual community. Empty until an admin sets them.
model ResourceSettings {
  id                String   @id @map("_id")
  masterTemplateUrl String   @default("")
  communityUrl      String   @default("")
  termsUrl          String   @default("")
  privacyUrl        String   @default("")
  updatedAt         DateTime @updatedAt
}

model TemplateEntry {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  category  String   @default("")
  imageUrl  String   @default("")
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model TemplateWish {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  title     String
  details   String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Admin-edited prices for the three crafter plans. One document for the whole toolkit.
model PlanCatalog {
  id                   String   @id @map("_id")
  monthlyPriceMinor    Int
  quarterlyPriceMinor  Int
  annualPriceMinor     Int
  updatedAt            DateTime @updatedAt
}

/// A purchase list the crafter sends to their own materials supplier.
model SupplierOrder {
  id           String              @id @default(cuid()) @map("_id")
  userId       String
  supplierName String
  status       String              @default("draft")
  note         String              @default("")
  currency     String              @default("PHP")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  receivedAt   DateTime?
  lines        SupplierOrderLine[]

  @@index([userId, updatedAt])
}

model SupplierOrderLine {
  id             String        @id @default(cuid()) @map("_id")
  orderId        String
  userId         String
  materialId     String
  materialName   String
  packs          Float
  packPriceMinor Int
  order          SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
}
